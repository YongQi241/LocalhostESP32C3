    {
        "id": "de5fbdf6cbf55a4b",
        "type": "function",
        "z": "dc67bc384f2f408d",
        "name": "function 2",
        "func": "// 1. Kiểm tra tính hợp lệ của dữ liệu đầu vào từ Firebase\nif (!msg.payload || typeof msg.payload !== 'object') {\n    msg.payload = []; // Trả về mảng rỗng nếu Cloud chưa có dữ liệu\n    return msg;\n}\n\nlet deviceArray = [];\nlet counter = 1;\n\n// 2. Lặp qua các node thiết bị (JSON Object) lấy từ Firebase\nfor (let key in msg.payload) {\n    let rawData = msg.payload[key];\n    \n    // 3. Chuẩn hóa dữ liệu theo đúng cấu trúc giao diện cần thiết\n    let deviceObj = {\n        // Tạo STT dạng 01, 02... Nếu không có tên thì để dấu \"?\" theo thiết kế\n        index: rawData.name ? (counter < 10 ? \"0\" + counter : counter.toString()) : \"?\",\n        \n        id: rawData.id || key,                          // Request ID (vd: C3-A19F)\n        name: rawData.name || \"Unknown ESP Signal\",     // Tên thiết bị\n        status: rawData.status || \"Weak signal\",        // Trạng thái ghép nối\n        rssi: rawData.rssi || -100,                     // Cường độ sóng đo từ mạch\n        \n        // 4. Logic CSS tự động phân loại màu sắc Badge\n        badgeClass: (rawData.status === \"Pairing mode\") ? \"new-request\" : \"verify\",\n        badgeText: (rawData.status === \"Pairing mode\") ? \"New request\" : \"Verify carefully\"\n    };\n    \n    deviceArray.push(deviceObj);\n    counter++;\n}\n\n// 5. Ghi đè dữ liệu ra thành dạng Mảng (Array) để UI Template xử lý\nmsg.payload = deviceArray;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 380,
        "wires": [
            [
                "93a54299133d8856",
                "1354bc062530ac21"
            ]
        ]
