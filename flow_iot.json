        "func": "// // 1. Lấy ID thiết bị đang được chọn\n// let currentId = flow.get(\"active_device_id\");\n\n// if (!currentId) {\n//     node.warn(\"Lỗi: Chưa chọn thiết bị!\");\n//     return null; // Ngắt luồng nếu không có ID\n// }\n\n// // 2. Tạo đường dẫn lưu cấu hình riêng cho ID đó\n// msg.topic = currentId + \"/settings\";\n\nlet currentId = \"xiao01\"; //id esp32\n\nmsg.topic = \"xiao/esp32c3/sensors/\" + currentId + \"/threshold\";\n\nreturn msg;\n",
