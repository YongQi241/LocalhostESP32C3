    {
        "id": "1b5aa022b5cc4070",
        "type": "ui-template",
        "z": "dc67bc384f2f408d",
        "group": "",
        "page": "",
        "ui": "f7e8e1d52d7c7ca1",
        "name": "",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<style>\n    #auth-overlay {\n        position: fixed;\n        top: 0;\n        left: 0;\n        width: 100vw;\n        height: 100vh;\n        background-color: #f4f5f7;\n        z-index: 99999;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        font-family: 'Inter', sans-serif;\n    }\n\n    .auth-card {\n        background: white;\n        padding: 32px;\n        border-radius: 16px;\n        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n        width: 100%;\n        max-width: 360px;\n        text-align: center;\n    }\n\n    .auth-input {\n        width: 100%;\n        padding: 12px;\n        margin: 8px 0 16px 0;\n        border: 1px solid #d1d5db;\n        border-radius: 8px;\n        box-sizing: border-box;\n    }\n\n    .auth-btn {\n        width: 100%;\n        padding: 12px;\n        background-color: #111827;\n        color: white;\n        border: none;\n        border-radius: 8px;\n        font-weight: 600;\n        cursor: pointer;\n    }\n\n    .auth-error {\n        color: #dc2626;\n        font-size: 14px;\n        margin-top: 12px;\n        display: none;\n    }\n\n    #logout-btn {\n        position: fixed;\n        top: 16px;\n        right: 16px;\n        z-index: 99998;\n        padding: 8px 16px;\n        background-color: #ef4444;\n        color: white;\n        border: none;\n        border-radius: 8px;\n        cursor: pointer;\n        display: none;\n    }\n</style>\n\n<!-- ĐÃ THÊM THUỘC TÍNH onclick ĐỂ ĐẢM BẢO NÚT LUÔN HOẠT ĐỘNG -->\n<div id=\"auth-overlay\">\n    <div class=\"auth-card\">\n        <h2>Đăng nhập Hệ thống</h2>\n        <p style=\"color: #6b7280; font-size: 14px; margin-bottom: 24px;\">Thiết bị theo dõi không gian</p>\n        <input type=\"email\" id=\"email\" class=\"auth-input\" placeholder=\"Email\" required>\n        <input type=\"password\" id=\"password\" class=\"auth-input\" placeholder=\"Mật khẩu\" required>\n\n        <button id=\"login-btn\" class=\"auth-btn\" onclick=\"window.doLogin()\">Xác thực Token</button>\n        <div id=\"auth-error\" class=\"auth-error\">Đang kiểm tra dữ liệu...</div>\n    </div>\n</div>\n<button id=\"logout-btn\" onclick=\"window.doLogout()\">Đăng xuất</button>\n\n<script src=\"https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js\"></script>\n<script src=\"https://www.gstatic.com/firebasejs/10.13.0/firebase-auth-compat.js\"></script>\n\n<script>\n    (function() {\n    // 1. Cấu hình Firebase (HÃY ĐIỀN API KEY CỦA BẠN VÀO ĐÂY)\n    const firebaseConfig = {\n        apiKey: \"\", \n        authDomain: \"iot-tracking-c20aa.firebaseapp.com\",\n        projectId: \"iot-tracking-c20aa\"\n    };\n\n    if (!firebase.apps.length) {\n        firebase.initializeApp(firebaseConfig);\n    }\n    const auth = firebase.auth();\n\n    // 2. Đưa form lên lớp trên cùng\n    setTimeout(() => {\n        const overlay = document.getElementById('auth-overlay');\n        const logoutBtn = document.getElementById('logout-btn');\n        if(overlay && logoutBtn) {\n            document.body.appendChild(overlay);\n            document.body.appendChild(logoutBtn);\n        }\n    }, 100);\n\n    // 3. Hàm xử lý đăng nhập (Được gọi trực tiếp từ HTML để chống lỗi bóng ma)\n    window.doLogin = function() {\n        const email = document.getElementById('email').value;\n        const pass = document.getElementById('password').value;\n        const btn = document.getElementById('login-btn');\n        const err = document.getElementById('auth-error');\n\n        if(!email || !pass) {\n            err.style.display = 'block';\n            err.innerText = \"Vui lòng nhập đủ thông tin!\";\n            return;\n        }\n\n        btn.innerText = \"Đang xác thực...\";\n        err.style.display = 'none';\n\n        auth.signInWithEmailAndPassword(email, pass)\n            .then(() => {\n                btn.innerText = \"Thành công!\";\n            })\n            .catch((error) => {\n                err.style.display = 'block';\n                err.innerText = \"Lỗi: \" + error.message; // Sẽ hiện mã lỗi chi tiết nếu sai\n                btn.innerText = \"Xác thực Token\";\n            });\n    };\n\n    // 4. Hàm xử lý đăng xuất\n    window.doLogout = function() {\n        auth.signOut();\n    };\n\n    // 5. Quản lý trạng thái đóng/mở màn hình\n    auth.onAuthStateChanged((user) => {\n        const overlay = document.getElementById('auth-overlay');\n        const logoutBtn = document.getElementById('logout-btn');\n        if(overlay && logoutBtn) {\n            if (user) {\n                overlay.style.display = 'none';\n                logoutBtn.style.display = 'block';\n            } else {\n                overlay.style.display = 'flex';\n                logoutBtn.style.display = 'none';\n            }\n        }\n    });\n})();\n</script>",
