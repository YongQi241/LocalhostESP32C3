# Copy this file to ".env" (same folder), fill in real values, then upload
# it to the device's LittleFS filesystem - see point 9 in the top comment
# of main.cpp for the upload steps (Arduino IDE data-upload tool, or
# "pio run --target uploadfs" for PlatformIO).
#
# Any line here is optional: leave a line out (or delete it) and the
# device falls back to the compiled-in default for that setting.
# Lines starting with # are comments. Values can optionally be wrapped
# in double quotes, e.g. WIFI_SSID="My Home Network".

WIFI_SSID=Wokwi-GUEST
WIFI_PASSWORD=

MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT_DEVICE_ID scopes both MQTT topics to
#   xiao/esp32c3/sensors/<MQTT_DEVICE_ID>/data
#   xiao/esp32c3/sensors/<MQTT_DEVICE_ID>/threshold
# Pick something hard to guess - it is effectively a shared secret on a
# public broker like broker.hivemq.com, since anyone who knows it can
# subscribe to your data topic.
MQTT_DEVICE_ID=change-me-to-something-random

# MQTT_ACCESS_KEY must be sent as the "key" field in any MQTT message that
# tries to change thresholds/awake_ms/zones. Messages without the correct
# key are ignored. Pick a long random string.
MQTT_ACCESS_KEY=change-me-to-a-long-random-string

FIREBASE_HOST=YOUR_PROJECT-default-rtdb.firebaseio.com
FIREBASE_AUTH=YOUR_DATABASE_SECRET_OR_ID_TOKEN

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
